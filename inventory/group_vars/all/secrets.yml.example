---
# Copy this to secrets.yml and encrypt it:
#
#   cp inventory/group_vars/all/secrets.yml.example inventory/group_vars/all/secrets.yml
#   ansible-vault encrypt inventory/group_vars/all/secrets.yml
#
# The vault password is read from the file named by $ANSIBLE_VAULT_PASSWORD_FILE.
#
# `-e stage=demo|prod` selects the matching entry in each top-level map. Both maps
# are required, and each must carry the stage the playbook runs with. Values shown
# here are placeholders, not real secrets.

# --- caterbill (playbooks/services/caterbill.yml) ---
caterbill:
  demo:
    hostname: demo.speisehof.de
    port: 8080
    runtime_user: caterbill
    mailer:
      forwardemail_api_key: ""
    backup:
      s3_endpoint: <s3_endpoint>
      s3_region: <s3_region>
      s3_access_key_id: ""
      s3_secret_access_key: ""
      s3_bucket_name: <demo_backup_bucket>
      passphrase: ""
  prod:
    hostname: rechnungen.speisehof.de
    port: 8081
    runtime_user: caterbill
    mailer:
      forwardemail_api_key: ""
    backup:
      s3_endpoint: <s3_endpoint>
      s3_region: <s3_region>
      s3_access_key_id: ""
      s3_secret_access_key: ""
      s3_bucket_name: <prod_backup_bucket>
      passphrase: ""

# --- sqlite-vault-verify (playbooks/services/sqlite-vault-verify.yml) ---
# The S3 credentials are usually the same as caterbill.<stage>.backup.
sqlite_vault_verify:
  demo:
    runtime_user: caterbill
    endpoint: <s3_endpoint>
    region: <s3_region>
    bucket: <demo_backup_bucket>
    access_key: ""
    secret_key: ""
    passphrase: ""
    alias: speisehof-rechnungen-backup.daily-latest.alias
    prefix: speisehof-rechnungen-backup
    max_age: 26h
    uptime_kuma_push_url: ""
  prod:
    runtime_user: caterbill
    endpoint: <s3_endpoint>
    region: <s3_region>
    bucket: <prod_backup_bucket>
    access_key: ""
    secret_key: ""
    passphrase: ""
    alias: speisehof-rechnungen-backup.daily-latest.alias
    prefix: speisehof-rechnungen-backup
    max_age: 26h
    uptime_kuma_push_url: ""
